{% macro renderGuidePagination(pagination) %}
    {% if pagination and (pagination.next or pagination.previous) %}
        <nav class="govuk-pagination govuk-pagination--block" aria-label="Pagination">

            {# Next link comes first #}
            {% if pagination.next %}
                <div class="govuk-pagination__next">
                    <a class="govuk-link govuk-pagination__link" href="{{ pagination.next.href }}" rel="next">
                    <svg class="govuk-pagination__icon govuk-pagination__icon--next" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                        <path d="m8.107-0.0078125-1.4136 1.414 4.2926 4.293h-12.986v2h12.896l-4.1855 3.9766 1.377 1.4492 6.7441-6.4062-6.7246-6.7266z"></path>
                    </svg>
                    <span class="govuk-pagination__link-title">
                        Next<span class="govuk-visually-hidden"> page</span>
                    </span>
                    <span class="govuk-visually-hidden">:</span>
                    <span class="govuk-pagination__link-label">{{ pagination.next.labelText}}</span>
                    </a>
                </div>
             
            {% endif%}

            {# Divider only if both pagination links present #}
            {% if pagination.next and pagination.previous %}
                <hr class="govuk-section-break govuk-section-break--visible">
            {% endif %}

            {# Previous link #}
            {% if pagination.previous %}
                <div class="govuk-pagination__prev">
                    <a class="govuk-link govuk-pagination__link" href="{{ pagination.previous.href }}" rel="prev">
                    <svg class="govuk-pagination__icon govuk-pagination__icon--prev" xmlns="http://www.w3.org/2000/svg" height="13" width="15" aria-hidden="true" focusable="false" viewBox="0 0 15 13">
                        <path d="m6.892-0.0078125 1.4136 1.414-4.2926 4.293h12.986v2h-12.896l4.1855 3.9766-1.377 1.4492-6.7441-6.4062 6.7246-6.7266z"></path>
                    </svg>
                    <span class="govuk-pagination__link-title">
                        Previous<span class="govuk-visually-hidden"> page</span>
                    </span>
                    <span class="govuk-visually-hidden">:</span>
                    <span class="govuk-pagination__link-label">{{ pagination.previous.labelText}}</span>
                    </a>
                </div>
            {% endif %}
        </nav> 
    {% endif %}
{% endmacro%}
{% macro renderGuideSubnav (guide, currentPageSlug, guideId, activeLayout) %}
    
    {% set layoutQuery = "?layout=" ~ activeLayout if activeLayout else "" %}

     <nav class="app-subnav" aria-labelledby="subnav-heading">
          <header class="govuk-!-margin-bottom-2">
            
            <h2 id="subnav-heading" class="govuk-heading-s govuk-visually-hidden">
              <span class="govuk-visually-hidden">
              Pages in
              </span>
              {{ guide.title }}
            </h2>
            
          </header>
          <ul class="app-subnav__section">
            {% for page in guide.pages %}
                {% set isCurrent = (page.slug == currentPageSlug) %}
                {% set pageHref = "/guides/" ~ guideId ~ "/" ~ page.slug ~ layoutQuery %}

                <li class="app-subnav__section-item {% if isCurrent %}app-subnav__section-item--current{% endif %}">
                    <a class="app-subnav__link govuk-link govuk-link--no-visited-state govuk-link--no-underline" 
                        href="{{ pageHref }}" 
                        {% if isCurrent %}aria-current="page"{% endif %}>
                        {{ page.text }}
                    </a>
                </li>
          {% endfor %}
          </ul>
        </nav>
{% endmacro %}